# Demo_Ecom environment
# Copy this file to .env (cp .env.example .env) and fill in every value.
# The application refuses to start when any of these is missing and names the
# missing variable in the message.

# PostgreSQL 15+ connection string used by the server, migrations and seed.
# Example: postgresql://ecom:ecom@localhost:5432/demo_ecom
DATABASE_URL=

# Random secret of at least 32 characters used to protect sessions.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Razorpay test-mode public key id (starts with rzp_test_). Safe to expose to
# the browser only on the checkout screen; an empty value stops startup.
RAZORPAY_KEY_ID=

# Razorpay test-mode key secret. Never sent to the browser.
RAZORPAY_KEY_SECRET=
