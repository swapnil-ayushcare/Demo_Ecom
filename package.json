{
  "name": "demo-ecom",
  "version": "0.1.0",
  "private": true,
  "description": "Demo_Ecom: a small, honest Indian shop that runs from one repository.",
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx scripts/run-next.ts dev",
    "build": "next build",
    "build:hosting": "node scripts/build-hosting.mjs",
    "start": "tsx scripts/run-next.ts start",
    "migrate": "tsx db/migrate.ts",
    "seed": "tsx db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-run.ts",
    "test:e2e": "playwright test --workers=4",
    "test:unit": "playwright test tests/money.spec.ts --workers=1"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "lucide-react": "^0.451.0",
    "next": "^14.2.35",
    "pg": "^8.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
